<Window x:Class="Apteka.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apteka"
        Title="{l:Tr 'Справка'}" Width="720" Height="560"
        WindowStartupLocation="CenterOwner">
    <TabControl x:Name="Tabs" Margin="8" Foreground="{x:Static SystemColors.ControlTextBrush}">
        <TabItem Header="{l:Tr 'Руководство пользователя'}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel x:Name="GuidePanel"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:Tr 'О программе'}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Аптека — Информационная система'}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{l:Tr 'Версия 1.0'}" Margin="0,6,0,0"/>
                    <TextBlock Text="{l:Tr 'Курсовой проект по дисциплине «Базы данных»'}" Margin="0,6,0,0"/>
                    <TextBlock Text="{l:Tr 'Вариант 3. Разработка фрагмента информационной системы Аптека'}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Separator Margin="0,16,0,16"/>
                    <TextBlock Text="Студент гр. АВТ-413, АВТФ" FontWeight="Bold"/>
                    <TextBlock Text="Михаил Михаил Рави Овейда"/>
                    <TextBlock Text="Руководитель: ассистент каф. АСУ Антонянц Е. Н." Margin="0,4,0,0"/>
                    <Separator Margin="0,16,0,16"/>
                    <TextBlock Text="{l:Tr 'Стек технологий:'}" FontWeight="Bold"/>
                    <TextBlock Text=".NET 10 · WPF · SQL Server 2022 · T-SQL"/>
                    <TextBlock Text="{l:Tr 'Технологии: параметризованные запросы, SHA-256, роль-ориентированное меню'}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
