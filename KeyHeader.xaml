<UserControl x:Class="Apteka.KeyHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Header block of the sign-in / change-password forms: key picture, cream line, gold line, white hint line -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto" MinHeight="30"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="#B9D1EA">
            <Viewbox Margin="8,4" Stretch="Uniform">
                <Canvas Width="64" Height="64">
                    <Canvas Width="60" Height="26" Canvas.Left="2" Canvas.Top="19" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="-40"/>
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="24" Canvas.Top="9" Width="34" Height="8" Fill="#F2C200" Stroke="#5A4400" StrokeThickness="1.2"/>
                        <Rectangle Canvas.Left="43" Canvas.Top="17" Width="6" Height="8" Fill="#F2C200" Stroke="#5A4400" StrokeThickness="1.2"/>
                        <Rectangle Canvas.Left="52" Canvas.Top="17" Width="6" Height="6" Fill="#F2C200" Stroke="#5A4400" StrokeThickness="1.2"/>
                        <Ellipse Width="26" Height="26" Fill="#F2C200" Stroke="#5A4400" StrokeThickness="1.5"/>
                        <Ellipse Canvas.Left="8" Canvas.Top="8" Width="10" Height="10" Fill="#B9D1EA" Stroke="#5A4400" StrokeThickness="1.2"/>
                    </Canvas>
                </Canvas>
            </Viewbox>
        </Border>

        <Border Grid.Column="1" Background="#FFFACD">
            <TextBlock x:Name="T1" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="#FFD700">
            <TextBlock x:Name="T2" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"/>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White">
            <TextBlock x:Name="T3" Foreground="Black" TextWrapping="Wrap" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="6,4"/>
        </Border>
    </Grid>
</UserControl>
