<Window x:Class="Apteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apteka"
        Title="{l:Tr 'Аптека — Информационная система'}" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top menu bar (system colors so the popups stay readable in every theme) -->
        <Menu DockPanel.Dock="Top"
              Background="{x:Static SystemColors.ControlBrush}"
              Foreground="{x:Static SystemColors.MenuTextBrush}">
            <MenuItem Header="{l:Tr 'Справочники'}" x:Name="MenuRefs"/>
            <MenuItem Header="{l:Tr 'Документы'}" x:Name="MenuDocs">
                <MenuItem Header="{l:Tr 'Оформление заказа'}" x:Name="MenuOrder" Click="ShowOrderPage"/>
                <MenuItem Header="{l:Tr 'Журналы документов'}" x:Name="MenuDocLists"/>
                <MenuItem Header="{l:Tr 'Отчёты и запросы'}" Click="ShowReportsPage"/>
                <Separator/>
                <MenuItem Header="{l:Tr 'Экспорт текущей таблицы в CSV'}" Click="ExportTable_Click"/>
            </MenuItem>
            <MenuItem Header="{l:Tr 'Аналитика'}" Click="ShowAnalyticsPage"/>
            <MenuItem Header="{l:Tr 'Справка'}">
                <MenuItem Header="{l:Tr 'Руководство пользователя'}" Click="ShowUserGuide_Click"/>
                <MenuItem Header="{l:Tr 'О программе'}" Click="ShowAbout_Click"/>
            </MenuItem>
            <MenuItem Header="{l:Tr 'Разное'}">
                <MenuItem Header="{l:Tr 'Настройка'}" Click="ShowSettings_Click"/>
                <MenuItem Header="{l:Tr 'Сменить пароль'}" x:Name="MenuPass" Click="ShowChangePass_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status strip -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppControlBg}"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="0,1,0,0"
                Padding="8,4">
            <DockPanel>
                <Button Content="{l:Tr 'Выход'}" DockPanel.Dock="Right" Padding="14,3" Click="Logout_Click"/>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main content area: pages swap into here -->
        <Grid x:Name="PageHost">
            <!-- Table page -->
            <DockPanel x:Name="PageTables" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                    <TextBlock x:Name="TxtPageTitle" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{l:Tr 'Поиск:'}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSearch" Width="240" TextChanged="Search_Changed"/>
                    <Button x:Name="BtnAdd" Content="{l:Tr 'Добавить'}" Margin="12,0,0,0" Padding="10,2" Click="Add_Click"/>
                    <Button x:Name="BtnEdit" Content="{l:Tr 'Изменить'}" Margin="6,0,0,0" Padding="10,2" Click="Edit_Click"/>
                    <Button x:Name="BtnDelete" Content="{l:Tr 'Удалить'}" Margin="6,0,0,0" Padding="10,2" Click="Delete_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtTableInfo" DockPanel.Dock="Bottom" Margin="8,4"/>
                <DataGrid x:Name="GridTable" IsReadOnly="True" AutoGenerateColumns="True"
                          SelectionMode="Single" AutoGeneratingColumn="Grid_AutoGen"
                          MouseDoubleClick="Grid_DoubleClick" Margin="8,0,8,8"/>
            </DockPanel>

            <!-- Order page -->
            <StackPanel x:Name="PageOrder" Visibility="Collapsed" Margin="24" Width="380"
                        HorizontalAlignment="Left">
                <TextBlock Text="{l:Tr 'Оформление заказа'}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                <TextBlock Text="{l:Tr 'Пациент'}"/>
                <ComboBox x:Name="CmbPatient" Margin="0,2,0,10"
                          DisplayMemberPath="txt" SelectedValuePath="id"/>
                <TextBlock Text="{l:Tr 'Лекарство'}"/>
                <ComboBox x:Name="CmbMedicine" Margin="0,2,0,10"
                          DisplayMemberPath="txt" SelectedValuePath="id"/>
                <TextBlock Text="{l:Tr 'Количество'}"/>
                <TextBox x:Name="TxtQty" Text="1" Margin="0,2,0,16"/>
                <Button Content="{l:Tr 'Оформить заказ'}" Padding="10,5" Click="CreateOrder_Click"/>
            </StackPanel>

            <!-- Reports page -->
            <DockPanel x:Name="PageReports" Visibility="Collapsed" Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="{l:Tr 'Шаблон отчёта:'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbReport" Width="440" DisplayMemberPath="Title"
                              SelectionChanged="Report_Changed"/>
                    <Button Content="{l:Tr 'Выполнить'}" Margin="8,0,0,0" Padding="12,2" Click="RunReport_Click"/>
                    <Button Content="{l:Tr 'Экспорт в CSV'}" Margin="8,0,0,0" Padding="12,2" Click="ExportReport_Click"/>
                </StackPanel>
                <!-- SQL is always left-to-right, even in Arabic -->
                <TextBox x:Name="TxtSql" DockPanel.Dock="Top" Height="120" Margin="0,8" AcceptsReturn="True"
                         FlowDirection="LeftToRight"
                         TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="TxtReportInfo" DockPanel.Dock="Bottom" Margin="0,6,0,0"/>
                <DataGrid x:Name="GridReport" IsReadOnly="True" AutoGenerateColumns="True"
                          AutoGeneratingColumn="Grid_AutoGen"/>
            </DockPanel>

            <!-- Analytics page: dashboard with four charts (bar, pie, line, bar) -->
            <DockPanel x:Name="PageAnalytics" Visibility="Collapsed" Margin="12">
                <DockPanel.Resources>
                    <Style x:Key="Card" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppControlBg}"/>
                        <Setter Property="BorderBrush" Value="{x:Static SystemColors.ControlDarkBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>
                </DockPanel.Resources>

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{l:Tr 'С:'}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="DtpFrom" Width="130"/>
                        <TextBlock Text="{l:Tr 'По:'}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <DatePicker x:Name="DtpTo" Width="130"/>
                        <Button Content="{l:Tr 'Применить фильтр'}" Margin="10,0,0,0" Padding="10,2" Click="Chart_Changed_Button"/>
                        <Button Content="{l:Tr 'Автообновление'}" x:Name="BtnAuto" Margin="10,0,0,0" Padding="10,2" Click="ToggleAuto"/>
                        <Button Content="{l:Tr 'Экспорт дашборда в PNG'}" Margin="10,0,0,0" Padding="10,2" Click="ExportChart_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtChartInfo" FontStyle="Italic" Margin="0,0,0,6"/>
                </StackPanel>

                <Grid x:Name="DashGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Tr 'Количество лекарств по категориям'}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <l:BarChart x:Name="ChartCategories"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Tr 'Заказы по статусам'}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <l:PieChart x:Name="ChartStatus"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Tr 'Заказы по дням (с фильтром по дате)'}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <l:LineChart x:Name="ChartDays"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Tr 'Средняя цена по категориям'}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <l:BarChart x:Name="ChartPrice" SingleColor="True"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
