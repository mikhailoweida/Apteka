<Window x:Class="Apteka.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apteka"
        Title="{l:Tr 'Настройка'}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="{l:Tr 'Настройка'}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="{l:Tr 'Тема оформления'}"/>
        <ComboBox x:Name="CmbTheme" Margin="0,2,0,12">
            <ComboBoxItem Content="{l:Tr 'Classic (классический 3D)'}"/>
            <ComboBoxItem Content="{l:Tr 'Light (светлая)'}"/>
            <ComboBoxItem Content="{l:Tr 'Dark (тёмная)'}"/>
            <ComboBoxItem Content="{l:Tr 'Blue (синяя)'}"/>
        </ComboBox>

        <TextBlock Text="{l:Tr 'Размер шрифта'}"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
            <Slider x:Name="SldFont" Minimum="10" Maximum="20" Width="260"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="Font_Changed"/>
            <TextBlock x:Name="TxtFont" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="{l:Tr 'Язык интерфейса'}"/>
        <ComboBox x:Name="CmbLang" Margin="0,2,0,16" DisplayMemberPath="Native"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr 'Сохранить'}" Width="110" Padding="0,5" Margin="0,0,8,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="{l:Tr 'Отмена'}" Width="90" Padding="0,5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
